# =============================================================================
# Inaaya Commerce Platform - configuration
#
# Copy to .env and fill in. START.cmd does this for you on first run, with
# random secrets. NEVER commit .env: it holds every password of the platform.
# =============================================================================

# ---------------------------------------------------------------- platform
APP_VERSION=1.0.0
# The address people type. Used for tracking links and CORS.
PUBLIC_BASE_URL=http://localhost:5080
# Port the gateway listens on. 5080 is where the handhelds look for the warehouse.
GATEWAY_PORT=5080
# The shop's clock: order numbers, "today", daily reports.
APP_TIMEZONE=Asia/Kuala_Lumpur
# true once the platform is served over HTTPS (it must be, on the internet).
COOKIE_SECURE=false

# ---------------------------------------------------------------- database
POSTGRES_DB=inaaya
POSTGRES_USER=inaaya
POSTGRES_PASSWORD=change-me-long-random
# Bound to 127.0.0.1 only - for backups and administration from this machine.
POSTGRES_HOST_PORT=5433
# Each module logs in as its own role and can only write its own schema.
WAREHOUSE_DB_PASSWORD=change-me-long-random
COURIER_DB_PASSWORD=change-me-long-random

# The two accounts a brand-new platform starts with (used once, when there are
# no accounts). Change both passwords after the first login.
PLATFORM_ADMIN_PASSWORD=admin123
PLATFORM_MERCHANT_PASSWORD=linked123

# ---------------------------------------------------------------- sign-in
# Signs every session token. At least 32 random characters. Changing it signs
# everybody out, on every device.
AUTH_JWT_SECRET=change-me-at-least-32-random-characters

# ---------------------------------------------------------- integration
# How often (seconds) J&T tracking statuses are read back into the warehouse.
COURIER_SYNC_SECONDS=20

# Queue WhatsApp "order created" messages (the courier module's notifier).
WHATSAPP_ENABLED=false

# Where product photos and the photo-search model live on this machine.
# WAREHOUSE_UPLOADS_DIR=./apps/warehouse/server/Warehouse.Api/uploads
# WAREHOUSE_MODELS_DIR=./apps/warehouse/server/Warehouse.Api/models
