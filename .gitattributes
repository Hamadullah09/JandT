# Shell scripts run inside Linux containers: they must keep LF line endings even
# when the repository is checked out on Windows.
*.sh      text eol=lf
*.sql     text eol=lf
*.conf    text eol=lf
Dockerfile text eol=lf

# Windows launchers keep CRLF.
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf

*.pdf     binary
*.png     binary
*.jpg     binary
*.onnx    binary
