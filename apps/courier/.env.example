# ---------------------------------------------------------------------------
# JT-CLONE environment. Copy to .env and adjust. All vars are prefixed JT_.
# ---------------------------------------------------------------------------

# The platform database (repository root .env). Use the asyncpg driver and the
# courier module's own role; its tables live in the `courier` schema.
#   platform (docker)  : postgresql+asyncpg://courier_app:<COURIER_DB_PASSWORD>@postgres:5432/inaaya
#   host machine       : postgresql+asyncpg://courier_app:<COURIER_DB_PASSWORD>@localhost:5433/inaaya
JT_DATABASE_URL=postgresql+asyncpg://courier_app:change-me@localhost:5433/inaaya
JT_DB_SCHEMA=courier

# Platform sign-in: the same value as AUTH_JWT_SECRET in the root .env.
JT_AUTH_JWT_SECRET=

# Root directory that bulk output directories must live under.
# Set to "" to allow any absolute path (host installs). Inside Docker this MUST
# stay /data/waybills because that is the only writable mounted volume.
JT_OUTPUT_ROOT=

# Tracking number generation -------------------------------------------------
JT_TRACKING_PREFIX=63
JT_TRACKING_MODE=SEQUENCE          # SEQUENCE | RANDOM
JT_TRACKING_SEQ_START=2158571544

# Waybill rendering ----------------------------------------------------------
JT_RENDER_WORKERS=0                # 0 = os.cpu_count()
JT_RENDER_CHUNK=32                 # rows handed to each pool task
JT_PIPELINE_CHUNK=1000             # rows per persist/render chunk
JT_MERGE_PDF=false                 # also emit merged_<batch_id>.pdf

# API ------------------------------------------------------------------------
JT_CORS_ORIGINS=["http://localhost:5080","http://127.0.0.1:5080"]
JT_MAX_UPLOAD_MB=64

# WhatsApp group notifications -------------------------------------------------
# Queue each new order (CLI and portal) for a WhatsApp group; jt-whatsapp.bat
# sends them. Off by default. See whatsapp/service.js.
JT_WHATSAPP_ENABLED=false
# Sending number with country code, no leading 0 - used to request a pairing
# code the first time you link. Leave empty to link with a QR code instead.
JT_WHATSAPP_PHONE=
# Product photos: the CSV "image" column, else a file named after the product.
JT_WHATSAPP_IMAGES_DIR=            # default <repo>/images
JT_WHATSAPP_OUTBOX_DIR=            # default <repo>/whatsapp/outbox

# Track & trace ----------------------------------------------------------------
# The tracking page links in the admin portal and in jt-export CSV files.
JT_TRACKING_PAGE_URL=http://localhost:5080/tracking/
JT_EXPORTS_DIR=                    # default <repo>/exports
